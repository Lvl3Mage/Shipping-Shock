// Each #kernel tells which function to compile; you can have many kernels
#pragma kernel FluidCalculateAcceleration
#pragma kernel FluidAddAcceleration
#pragma kernel FluidApplyAcceleration

// Create a RenderTexture with enableRandomWrite flag and set it
// with cs.SetTexture
RWTexture2D<float2> velocityMap;
RWTexture2D<float2> accelerationMap;
// RWTexture2D<float2> pressureMap;

float inv_halfBleedoverSpeed;
float blurSpeed;
float decaySpeed;
float timeScale;
float2 appliedVelocity;
int2 appliedPoint;
// int2 dimentions;
int2 blockOffset;

